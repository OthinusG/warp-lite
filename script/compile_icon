#!/bin/bash
# Install the shared Warpai icon for the inherited channel bundle entry point.
# Usage: compile_icon <channel> <app_bundle_path>
set -euo pipefail

if [[ "$#" -ne 2 ]]; then
    echo "Usage: compile_icon <channel> <app_bundle_path>" >&2
    exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_BUNDLE_PATH="$2"
mkdir -p "$APP_BUNDLE_PATH/Contents/Resources"
cp "$REPO_ROOT/app/assets/branding/warpai.icns" "$APP_BUNDLE_PATH/Contents/Resources/AppIcon.icns"
plutil -replace CFBundleIconFile -string "AppIcon" "$APP_BUNDLE_PATH/Contents/Info.plist"
# Legacy Icon Composer metadata must not override the shared reviewed resource.
plutil -remove CFBundleIconName "$APP_BUNDLE_PATH/Contents/Info.plist" >/dev/null 2>&1 || true
